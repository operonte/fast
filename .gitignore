app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Artefactos de release (van a la sección Releases de GitHub, no al repo)
release/*.apk
release/*.aab
*.apk
*.aab

# Secretos de firma (defensa en profundidad; ver android/.gitignore)
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.p8
