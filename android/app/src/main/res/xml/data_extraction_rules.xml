<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): excluye TODOS los datos de la app de las copias de
  seguridad en la nube y de las transferencias dispositivo-a-dispositivo.
  El historial de números contactados es información sensible y no debe salir
  del dispositivo. Complementa android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
